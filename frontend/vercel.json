{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-olive-theta-58.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://backend-olive-theta-58.vercel.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
